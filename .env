# ============================================================
# SIG - EMERGENCIA · Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# NUNCA publiques el .env en un repositorio.
# ============================================================

# ---- Base de datos SQLite (ruta relativa a la raíz del proyecto) ----
DB_PATH=database/sig_emergencia.sqlite

# ---- Aplicación ----
APP_NAME="SIG - EMERGENCIA"
APP_SUBTITLE="Sistema Integrado de Decisiones Rápidas y Asistencia de Recursos"
APP_COUNTRY="El Salvador"
APP_UPDATED_AT="14:25"

# ---- Teselas del mapa (proveedor de tiles) ----
TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
TILE_SUBDOMAINS="abc"
TILE_MAX_ZOOM=19
TILE_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright' target='_blank' rel='noopener'>OpenStreetMap</a> contributors"

# ---- Nominatim (geocodificación: buscador + clic en mapa) ----
NOMINATIM_URL="https://nominatim.openstreetmap.org"
NOMINATIM_LANG="es"
NOMINATIM_LIMIT=6
# Código ISO del país para priorizar búsquedas (vacío = todo el mundo)
NOMINATIM_COUNTRY="sv"

# ---- Vista inicial del mapa ----
MAP_CENTER_LAT=13.7942
MAP_CENTER_LON=-88.8965
MAP_ZOOM=8
MAP_HEAT_ZOOM=9

# ---- Red mesh (alcance de radioenlace en km y nodo central) ----
MESH_RANGE_KM=60
MESH_NODO_CENTRAL=1
