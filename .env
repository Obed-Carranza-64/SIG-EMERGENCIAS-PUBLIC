# ============================================================
# SIG - EMERGENCIA · Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# NUNCA publiques el .env en un repositorio.
# ============================================================

# ---- Base de datos SQLite (ruta relativa a la raíz del proyecto) ----
DB_PATH=database/sig_emergencia.sqlite

# ---- Aplicación ----
APP_NAME="SIG - EMERGENCIA"
APP_SUBTITLE="Sistema Integrado de Decisiones Rápidas y Asistencia de Recursos"
APP_COUNTRY="El Salvador"
APP_UPDATED_AT="14:25"

# ---- Teselas del mapa (proveedor de tiles) ----
TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
TILE_SUBDOMAINS="abc"
TILE_MAX_ZOOM=19
TILE_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright' target='_blank' rel='noopener'>OpenStreetMap</a> contributors"

# ---- Nominatim (geocodificación: buscador + clic en mapa) ----
NOMINATIM_URL="https://nominatim.openstreetmap.org"
NOMINATIM_LANG="es"
NOMINATIM_LIMIT=6
# Código ISO del país para priorizar búsquedas (vacío = todo el mundo)
NOMINATIM_COUNTRY="sv"

# ---- Vista inicial del mapa ----
MAP_CENTER_LAT=13.7942
MAP_CENTER_LON=-88.8965
MAP_ZOOM=8
MAP_HEAT_ZOOM=9

# ---- Red mesh (alcance de radioenlace en km y nodo central) ----
MESH_RANGE_KM=60
MESH_NODO_CENTRAL=1

# ---- Sismos (API sismia / MARN - SNET) ----
# Endpoint público del que se extraen los últimos sismos.
SISMOS_URL="https://sismia.onrender.com/api/sismos"
# Icono de Font Awesome para los marcadores de sismo.
SISMOS_ICON="fa-house-crack"
# Segundos mínimos entre sincronizaciones automáticas (0 = sin caché).
SISMOS_TTL=900
# Timeout en segundos para la descarga de la API.
SISMOS_TIMEOUT=8
# Sincronizar automáticamente al abrir el mapa de alertas (1 = sí).
SISMOS_AUTOSYNC=1
# Días que se conservan los sismos ya registrados.
SISMOS_KEEP_DAYS=30

# ---- Imágenes adjuntas de reportes (carpeta fuera del proyecto) ----
# Ruta absoluta donde se guardan las imágenes subidas.
UPLOAD_DIR="C:/xampp/htdocs/temp"
# URL pública desde la raíz del dominio para mostrarlas.
UPLOAD_URL="/temp"
# Límites de subida.
UPLOAD_MAX_MB=6
UPLOAD_MAX_FILES=5
